# ⚠ PLACEHOLDER — Elena fills these with the REAL web-app config from the Firebase
# console (grays2-mygames-live → Project settings → Your apps → Web app) before the
# first hosting deploy. The app WILL break in production until these are real.
VITE_FIREBASE_API_KEY=REPLACE_WITH_REAL_API_KEY
